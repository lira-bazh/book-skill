{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "emitDeclarationOnly": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "outDir": "livelib-wishlist/dist",
    "rootDir": "livelib-wishlist/scripts",
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "livelib-wishlist/scripts/**/*.mjs",
    "livelib-wishlist/scripts/**/*.mts"
  ],
  "exclude": ["livelib-wishlist/dist"]
}
